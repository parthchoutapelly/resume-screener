# VITE_API_BASE_URL and VITE_API_PROXY_TARGET are generated by
# scripts/gen-frontend-env.sh <env> from live CloudFormation stack outputs.
# Do NOT commit .env.dev or .env.prod — they are git-ignored.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=https://YOUR_API_GATEWAY_URL/dev
VITE_USER_POOL_ID=ap-south-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_REGION=ap-south-1
VITE_DISTRIBUTION_DOMAIN=
# Set to true to enable the "Open original resume" link (FR22 / FEATURE_RESUME_VIEW)
VITE_FEATURE_RESUME_VIEW=false
# Set to true to use in-memory mock data (no backend required)
VITE_USE_MOCKS=false
